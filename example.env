# Local LM Studio / Ollama
LLM_BACKEND=openai
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b
# LLM controller: query the LLM once every N simulation steps and hold the action.
# 1 step = 15 min → 4 = query once per hour, 8 = once per 2 hours.
LLM_CALL_INTERVAL=1
# LLM request timeout in seconds. Leave empty for no timeout (recommended for slow local models).
LLM_TIMEOUT=